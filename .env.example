AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-api-key>
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-01

# Azure Content Understanding
AZURE_CU_ENDPOINT=https://<your-cu-resource>.cognitiveservices.azure.com/
AZURE_CU_API_KEY=<your-cu-api-key>
# Optional fallback when UI analyzer selection is empty
AZURE_CU_ANALYZER_ID=<your-custom-analyzer-id>
AZURE_CU_API_VERSION=2025-05-01-preview
AZURE_CU_PARTS_FIELD=parts
AZURE_CU_TITLE_FIELD=title
AZURE_CU_PAGE_FIELD=page
AZURE_CU_BBOX_FIELD=bbox

# PDF rendering
# Higher DPI improves AzureCU image-analysis stability, at the cost of memory and processing time.
PDF_RENDER_DPI=300
